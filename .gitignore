# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Build output：开发构建统一落 build/（发布包在 dist/，见下）
/build/
/sol
/sol.exe
/sol-*
/sol.yaml
# 安装脚本在"你执行它的那个目录"生成的产物（含 UAC 那一步的日志）。
# 注意：scripts/sol.yaml 是**发布包里要带的模板**，下面用 ! 明确放行（install.yaml 不再随包带）。
/install.yaml
/sol.yaml
/elevated-*.log

# 安装脚本在"你执行它的那个目录"留下的东西：仓库里的 scripts/ 是常见落点（不少人是 cd scripts 再跑），
# 但那里的 sol / sol.bak / 日志属于使用者自己的运行时文件，不进仓库。
# 例外：scripts/sol.yaml 是打包带上的运行配置模板，要进仓库。
/scripts/sol
/scripts/sol.bak
/scripts/install.yaml
!/scripts/sol.yaml
/scripts/elevated-*.log

# 发布产物（scripts/release.sh 的落点）
/dist/

# 编辑器与工作区数据：JetBrains 的 .idea/ 里大多是机器相关的文件（sol.iml、
# workspace.xml.bak-goroot 之类，换台机器就变），.workbuddy/ 是本项目的记忆笔记。
# 两者都不属于仓库内容。
/.idea/
/.workbuddy/
# Finder 在 macOS 上随手扔下来的目录元数据。
.DS_Store

# 安装脚本在提权阶段的进度文件：属于本地残留，不提交。
elevated-*.progress

# 安装脚本的本地验证目录（沙箱根、假 sudo/uname、端到端产物）：跑 .soltest.sh / .shsandbox 用，
# 只在本机存在，不进仓库。
.sbtest*/
.sbsandbox/
.shsandbox/
.soltest.sh

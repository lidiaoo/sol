# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Build output：开发构建统一落 build/（发布包在 dist/，见下）
/build/
/sol
/sol.exe
/sol-*
/sol.yaml
# 安装脚本在"你执行它的那个目录"生成的产物（含 UAC 那一步的日志）
/install.yaml
/sol.yaml
/elevated-*.log

# 安装脚本在"你执行它的那个目录"留下的东西：仓库里的 scripts/ 是常见落点（不少人是 cd scripts 再跑），
# 但那里的 sol / sol.yaml / install.yaml 属于使用者自己的运行时文件，不进仓库。
/scripts/sol
/scripts/sol.bak
/scripts/sol.yaml
/scripts/install.yaml
/scripts/elevated-*.log

# 发布产物（scripts/release.sh 的落点）
/dist/
